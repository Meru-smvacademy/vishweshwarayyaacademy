# Environment variables required by the public website.
# Copy this file to .env.local and fill in real values for local development,
# or configure these same keys in your hosting provider's project settings
# for production/preview deployments.
#
# Both variables below are NEXT_PUBLIC_ — they are bundled into client-side
# JavaScript and are not secrets. Do not add non-public/secret values to
# NEXT_PUBLIC_-prefixed variables.

# External KRITPrep platform URL, used for the "KRITPrep" nav link, footer
# link, and the "Our Team" link on the About page. Falls back to "#" if unset.
# Source: src/config/nav.ts
NEXT_PUBLIC_KRITPREP_URL=https://www.kritprep.com

# Academy contact phone number in tel:-compatible format (no spaces), used by
# the mobile sticky "Call Now" button. Falls back to an empty string if unset.
# Source: src/config/nav.ts
NEXT_PUBLIC_ACADEMY_PHONE=+910000000000

# ---------------------------------------------------------------------------
# Admin Dashboard (admin-dashboard branch only — not used by the public site)
# ---------------------------------------------------------------------------
# Supabase project URL and anon/public key, used for Admin authentication
# (Supabase Auth) via @supabase/ssr. Find these in your Supabase project's
# Settings -> API page. The anon key is safe to expose to the browser — it is
# NOT the service_role key. Never put a service_role key in a NEXT_PUBLIC_
# variable.
# Source: src/lib/supabase/{client,server,middleware}.ts
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ---------------------------------------------------------------------------
# SNT Scholarship Exam — paid registration + hall tickets
# ---------------------------------------------------------------------------
# SERVER-ONLY (never prefix with NEXT_PUBLIC_). Supabase service_role / secret
# key, used by the /api/scholarship/* routes to write registrations, upload
# photos to the private snt-photos bucket, and render hall tickets.
# Source: src/lib/supabase/admin.ts
SUPABASE_SERVICE_ROLE_KEY=

# SERVER-ONLY. Kalbantt payment service (holds all Razorpay credentials; this
# project never sees the Razorpay secret). Full URL of the create-order endpoint
# and the bearer token this site uses to call it.
# Source: src/lib/snt/kalbanttPay.ts
KALBANTT_PAY_API_URL=
KALBANTT_PAY_SERVICE_TOKEN=

# SERVER-ONLY. Shared HMAC secret the Kalbantt service uses to sign calls to
# POST /api/scholarship/payment-status. Source: src/lib/snt/callbackSignature.ts
SNT_CALLBACK_SECRET=

# Razorpay publishable key id (rzp_test_... / rzp_live_...). Public by design.
# Source: src/components/scholarship/SntRegistrationStatus.tsx
NEXT_PUBLIC_RAZORPAY_KEY_ID=
